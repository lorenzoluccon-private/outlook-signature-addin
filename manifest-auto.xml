<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides"
           xsi:type="MailApp">

  <Id>8f443041-3379-4955-a6e1-ec63960cb4a3</Id>
  <Version>1.0.0.5</Version>
  <ProviderName>FG Automazioni S.r.l.</ProviderName>
  <DefaultLocale>it-IT</DefaultLocale>

  <DisplayName DefaultValue="Firma aziendale FG automatica"/>

  <Description
      DefaultValue="Inserisce automaticamente la firma email aziendale nei nuovi messaggi Outlook."/>

  <IconUrl
      DefaultValue="https://signature.fgautomazioni.it/assets/icon-64.png"/>

  <HighResolutionIconUrl
      DefaultValue="https://signature.fgautomazioni.it/assets/icon-128.png"/>

  <SupportUrl
      DefaultValue="https://www.fgautomazioni.it/"/>

  <AppDomains>
    <AppDomain>https://signature.fgautomazioni.it</AppDomain>
    <AppDomain>https://www.fgautomazioni.it</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox"/>
    </Sets>
  </Requirements>

  <!--
      Sezione legacy richiesta per la validazione.
      Viene sovrascritta dalla sezione VersionOverrides.
  -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation
            DefaultValue="https://signature.fgautomazioni.it/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule
        xsi:type="ItemIs"
        ItemType="Message"
        FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>true</DisableEntityHighlighting>

  <!--
      VersionOverrides 1.0 funge da contenitore per la versione 1.1.
  -->
  <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
      xsi:type="VersionOverridesV1_0">

    <VersionOverrides
        xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
        xsi:type="VersionOverridesV1_1">

      <Description resid="App.Description"/>

      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <!--
              Runtime utilizzato dagli eventi automatici.

              Commands.Url carica commands.html su Outlook Mac,
              Outlook Web e nuovo Outlook.

              Commands.Script.Url carica commands.js negli ambienti
              che richiedono direttamente il runtime JavaScript.
          -->
          <Runtimes>
            <Runtime resid="Autorun.Url">
              <Override
                  type="javascript"
                  resid="Autorun.Script.Url"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>

            <!-- Runtime dei normali comandi della barra Outlook. -->
            <FunctionFile resid="Commands.Url"/>

            <!-- Pulsanti manuali mantenuti come fallback. -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgComposeGroup">

                  <Label resid="GroupLabel"/>

                  <Control
                      xsi:type="Button"
                      id="OpenTaskpaneButton">

                    <Label resid="TaskpaneButton.Label"/>

                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>

                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>

                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>

                  </Control>

                  <Control
                      xsi:type="Button"
                      id="InsertSignatureButton">

                    <Label resid="ActionButton.Label"/>

                    <Supertip>
                      <Title resid="ActionButton.Label"/>
                      <Description resid="ActionButton.Tooltip"/>
                    </Supertip>

                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>

                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>action</FunctionName>
                    </Action>

                  </Control>

                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!--
                Evento automatico eseguito quando viene aperta
                la composizione di un nuovo messaggio.
            -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent
                    Type="OnNewMessageCompose"
                    FunctionName="onNewMessageCompose"/>
              </LaunchEvents>

              <SourceLocation resid="Autorun.Url"/>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>

        <bt:Images>
          <bt:Image
              id="Icon.16x16"
              DefaultValue="https://signature.fgautomazioni.it/assets/icon-16.png"/>

          <bt:Image
              id="Icon.32x32"
              DefaultValue="https://signature.fgautomazioni.it/assets/icon-32.png"/>

          <bt:Image
              id="Icon.80x80"
              DefaultValue="https://signature.fgautomazioni.it/assets/icon-80.png"/>
        </bt:Images>

        <bt:Urls>
          <!--
              Il resid deve coincidere con quello dichiarato
              sia in Runtime sia in LaunchEvent/SourceLocation.
          -->
          <bt:Url
              id="Commands.Url"
              DefaultValue="https://signature.fgautomazioni.it/commands.html?v=5"/>

          <bt:Url
              id="Commands.Script.Url"
              DefaultValue="https://signature.fgautomazioni.it/commands.js?v=5"/>

          <bt:Url
              id="Autorun.Url"
              DefaultValue="https://signature.fgautomazioni.it/autorun.html?v=1"/>

          <bt:Url
              id="Autorun.Script.Url"
              DefaultValue="https://signature.fgautomazioni.it/autorun.js?v=1"/>

          <bt:Url
              id="Taskpane.Url"
              DefaultValue="https://signature.fgautomazioni.it/taskpane.html"/>
        </bt:Urls>

        <bt:ShortStrings>
          <bt:String
              id="GroupLabel"
              DefaultValue="Firma aziendale FG"/>

          <bt:String
              id="TaskpaneButton.Label"
              DefaultValue="Gestione firma"/>

          <bt:String
              id="ActionButton.Label"
              DefaultValue="Inserisci firma aziendale"/>
        </bt:ShortStrings>

        <bt:LongStrings>
          <bt:String
              id="App.Description"
              DefaultValue="Inserisce automaticamente la firma email aziendale nei nuovi messaggi Outlook."/>

          <bt:String
              id="TaskpaneButton.Tooltip"
              DefaultValue="Apre il pannello di gestione della firma aziendale."/>

          <bt:String
              id="ActionButton.Tooltip"
              DefaultValue="Inserisce la firma aziendale aggiornata nel messaggio."/>
        </bt:LongStrings>

      </Resources>

    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>